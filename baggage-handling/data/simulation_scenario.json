  "jams": [
    {
      "jam_id": "J001",
      "edge_id": "e_JA2_S2",
      "start_tick": 67,
      "duration": 18,
      "note": "First pressure phase. Punishes students who hardcoded the A-side shortcut. Forces reroute through JA1→S1 or the longer spine path."
    },
    {
      "jam_id": "J002",
      "edge_id": "e_S2_S3",
      "start_tick": 143,
      "duration": 22,
      "note": "Sustained load phase, hits after the false-security trough. S2 chokepoint becomes a dead end mid-spine. Bags bound for GA3/GA4 must reroute via S1→S2→... or cross-terminal."
    },
    {
      "jam_id": "J003",
      "edge_id": "e_JB3_JB5",
      "start_tick": 197,
      "duration": 15,
      "note": "Crisis peak. Blocks the entry into the B-side loop trap. Bags entering via IB2→JB3 can no longer fall into the trap, but the main JB3→JB4 flow is also disrupted, stressing the B-side junction layer."
    },
    {
      "jam_id": "J004",
      "edge_id": "e_S4_S5",
      "start_tick": 213,
      "duration": 20,
      "note": "Crisis peak, second jam in quick succession. The B-side chokepoint spine link goes down during peak bag density. Forces all B-side traffic through S6 detour or cross-terminal reroute. Designed to coincide with the 5-bag burst at tick 207-209."
    },
    {
      "jam_id": "J005",
      "edge_id": "e_S1_S6",
      "start_tick": 263,
      "duration": 25,
      "note": "Wind-down surprise. Targets the slow detour belt — students who over-relied on it as a guaranteed fallback are caught. The S6→S5 half of the detour remains open, so complete fallback is not eliminated, only degraded."
    }
  ],

  "notes": {
    "bag_count": 91,
    "deadline_bag_count": 28,
    "jam_count": 5,
    "burst_ticks": [30, 31, 128, 129, 183, 184, 185, 207, 208, 209, 280, 281],
    "design_notes": [
      "Bags with no deadline_tick have no flight window — they score on transit time only, not misroute.",
      "Burst events never place more than 2 bags on the same intake node at the same tick.",
      "J002 hits during the quiet trough (ticks 140-150) described in the design — false sense of security.",
      "J003 and J004 overlap in time (J003 ends tick 212, J004 starts tick 213) creating a sustained B-side crisis.",
      "J005 targets the detour belt specifically to challenge students who built a hardcoded fallback path.",
      "Phases are informational — the evaluator does not need to enforce them, they are for scenario readability."
    ]
  }
